# Mnemosyne Development Environment
# Use for local development with test data

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# =============================================================================
# Ollama Configuration (use existing host service)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen3:0.6b

# =============================================================================
# Weaviate Configuration (local Docker)
# =============================================================================
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051

# Collection Names (dev-specific to avoid conflicts)
WEAVIATE_COLLECTION_MUSES=TheMuses_Dev
WEAVIATE_COLLECTION_LETHE=TheLethe_Dev
WEAVIATE_COLLECTION_DISCOVERY=DiscoveryDB_Dev

# =============================================================================
# PostgreSQL Configuration (local Docker)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemosyne_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword

# =============================================================================
# Test Data Paths (FAST ITERATION)
# =============================================================================
VAULT_PATH=test_data/test_vault
EMAIL_ARCHIVE_PATH=test_data/test_emails
PDF_SCAN_PATH=test_data/test_pdfs
EMAIL_TSV=test_data/cleaned_emails_sample.tsv

# =============================================================================
# Ingestion Configuration (optimized for dev speed)
# =============================================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=100
WATCHER_INTERVAL=10  # 10 seconds (fast polling for development)
EMBEDDING_BATCH_SIZE=5  # Small batches for easier debugging

# =============================================================================
# Scout Configuration (dev settings)
# =============================================================================
SCOUT_CONFIDENCE_THRESHOLD=0.7
SCOUT_RUN_INTERVAL=1  # 1 hour (for testing)

# =============================================================================
# Gatekeeper Configuration
# =============================================================================
GATEKEEPER_AUTO_APPROVE_THRESHOLD=0.9
GATEKEEPER_APPROVAL_TIMEOUT=48

# =============================================================================
# Telegram Bot (optional in development)
# =============================================================================
# TELEGRAM_BOT_TOKEN=your_dev_bot_token_here
# TELEGRAM_USER_ID=your_telegram_id

# =============================================================================
# Linear Integration (shared across environments)
# =============================================================================
LINEAR_API_KEY=lin_api_jgaqAtna0sBPk4Xd3qm0HXED
