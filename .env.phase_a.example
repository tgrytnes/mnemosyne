# Phase A runner configuration (copy to .env.phase_a.local and edit)

# Runs to execute (comma-separated identifiers)
PHASE_A_RUNS=baseline,late,contextual

# Default run settings
PHASE_A_DEFAULT_OUTPUT_ROOT=data/phase_a
PHASE_A_DEFAULT_CHUNKING_STRATEGY=recursive
PHASE_A_DEFAULT_CHUNKING_AUGMENTATION=none
PHASE_A_DEFAULT_EMBEDDING_PROVIDER=fastapi
PHASE_A_DEFAULT_EMBEDDING_MODEL=jinaai/jina-embeddings-v3
PHASE_A_DEFAULT_LLM_PROVIDER=fastapi
PHASE_A_DEFAULT_LLM_MODEL=smart
PHASE_A_DEFAULT_CONTEXTUAL_LLM_PROVIDER=fastapi
PHASE_A_DEFAULT_CONTEXTUAL_LLM_MODEL=Qwen3_4B
PHASE_A_DEFAULT_CONTEXTUAL_MAX_DOC_CHARS=2000
PHASE_A_DEFAULT_LATE_CHUNK_ADAPTER=retrieval.passage

# Step control
PHASE_A_STEPS=ingest,cluster,profile,export
PHASE_A_N_CLUSTERS=20

# Optional external commands
# PHASE_A_SAMPLE_COMMAND="./scripts/phase_a_sample.sh"
# PHASE_A_EXPORT_COMMAND="./scripts/phase_a_export.sh"

# Reset between runs (runner flag required)
PHASE_A_RESET_ENV=dev

# Environment settings for services
OBSIDIAN_VAULT_PATH=/data/vault
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8082
WEAVIATE_GRPC_PORT=50062

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemosyne_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

FASTAPI_BASE_URL=http://localhost:18000

# Run overrides
PHASE_A_RUN_baseline_RUN_ID=baseline_recursive
PHASE_A_RUN_baseline_CHUNKING_AUGMENTATION=none

PHASE_A_RUN_late_RUN_ID=late_recursive
PHASE_A_RUN_late_CHUNKING_AUGMENTATION=late

PHASE_A_RUN_contextual_RUN_ID=contextual_recursive
PHASE_A_RUN_contextual_CHUNKING_AUGMENTATION=contextual
PHASE_A_RUN_contextual_CONTEXTUAL_LLM_MODEL=Qwen3_4B
