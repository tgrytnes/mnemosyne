# Mnemosyne Production Environment
# Use for Raspberry Pi deployment with full data

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# Ollama Configuration (Docker network)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen3:0.6b

# =============================================================================
# Weaviate Configuration (Docker network)
# =============================================================================
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051

# Collection Names (production)
WEAVIATE_COLLECTION_MUSES=TheMuses
WEAVIATE_COLLECTION_LETHE=TheLethe
WEAVIATE_COLLECTION_DISCOVERY=DiscoveryDB

# =============================================================================
# PostgreSQL Configuration (Docker network)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemosyne
POSTGRES_USER=mnemosyne_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# =============================================================================
# Production Data Paths (mounted volumes)
# =============================================================================
VAULT_PATH=/mnt/sda1/digital_vault/02_active/notes/Obsidian
EMAIL_ARCHIVE_PATH=/mnt/sda1/digital_vault/raw_email_archive
PDF_SCAN_PATH=/mnt/sda1/digital_vault/01_inbox/scans
EMAIL_TSV=/mnt/sda1/digital_vault/cleaned_emails_full.tsv

# =============================================================================
# Ingestion Configuration (optimized for production)
# =============================================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=100
WATCHER_INTERVAL=300  # 5 minutes (less aggressive polling)
EMBEDDING_BATCH_SIZE=20  # Larger batches for efficiency

# =============================================================================
# Scout Configuration (production settings)
# =============================================================================
SCOUT_CONFIDENCE_THRESHOLD=0.7
SCOUT_RUN_INTERVAL=24  # 24 hours (nightly scan)

# =============================================================================
# Gatekeeper Configuration
# =============================================================================
GATEKEEPER_AUTO_APPROVE_THRESHOLD=0.9
GATEKEEPER_APPROVAL_TIMEOUT=48

# =============================================================================
# Telegram Bot (production)
# =============================================================================
TELEGRAM_BOT_TOKEN=CHANGE_ME_IN_PRODUCTION
TELEGRAM_USER_ID=CHANGE_ME_IN_PRODUCTION

# =============================================================================
# Linear Integration
# =============================================================================
LINEAR_API_KEY=lin_api_jgaqAtna0sBPk4Xd3qm0HXED
