# Mnemosyne Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Ollama Configuration
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen3:0.6b

# =============================================================================
# Weaviate Configuration
# =============================================================================
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051

# Weaviate Collection Names
WEAVIATE_COLLECTION_MUSES=TheMuses          # Obsidian vault (curated knowledge)
WEAVIATE_COLLECTION_LETHE=TheLethe          # Email archive + PDFs
WEAVIATE_COLLECTION_DISCOVERY=DiscoveryDB   # Scout findings

# =============================================================================
# PostgreSQL Configuration (The Ananke - committed projects)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemosyne
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# =============================================================================
# Test Data Paths (use during development)
# =============================================================================
TEST_VAULT_PATH=/home/tgrytnes/projects/Mnemosyne/test_data/test_vault
TEST_EMAIL_PATH=/home/tgrytnes/projects/Mnemosyne/test_data/test_emails
TEST_PDF_PATH=/home/tgrytnes/projects/Mnemosyne/test_data/test_pdfs
TEST_EMAIL_TSV=/home/tgrytnes/projects/Mnemosyne/test_data/cleaned_emails_sample.tsv

# =============================================================================
# Production Data Paths (use when ready for full ingestion)
# =============================================================================
VAULT_PATH=/mnt/sda1/digital_vault/02_active/notes/Obsidian
EMAIL_ARCHIVE_PATH=/mnt/sda1/digital_vault/raw_email_archive
PDF_SCAN_PATH=/mnt/sda1/digital_vault/01_inbox/scans
EMAIL_TSV=/mnt/sda1/digital_vault/cleaned_emails_full.tsv

# =============================================================================
# Telegram Bot Configuration (Phase 4+)
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id

# =============================================================================
# Linear Integration (Optional - for project management)
# =============================================================================
# Get your API key from: https://linear.app/settings/api
# Store in .env.local or secrets/linear_api_key
# LINEAR_API_KEY=lin_api_xxxxxxxxxxxxx

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Ingestion Configuration
# =============================================================================
# Chunk size for text splitting (characters)
CHUNK_SIZE=400
CHUNK_OVERLAP=100

# File watcher interval (seconds)
WATCHER_INTERVAL=60

# Batch size for embeddings
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# Scout Configuration (Phase 4)
# =============================================================================
# Pattern detection confidence threshold (0.0 - 1.0)
SCOUT_CONFIDENCE_THRESHOLD=0.7

# Scout run interval (hours)
SCOUT_RUN_INTERVAL=24

# =============================================================================
# Monitor Agent Configuration (Phase 4)
# =============================================================================
# Proposal confidence threshold (0.0 - 1.0)
MONITOR_CONFIDENCE_THRESHOLD=0.7

# Max discoveries to scan per run
MONITOR_SCAN_LIMIT=200

# =============================================================================
# Gatekeeper Configuration (Phase 4)
# =============================================================================
# Auto-approve threshold for high-confidence discoveries (0.0 - 1.0)
GATEKEEPER_AUTO_APPROVE_THRESHOLD=0.9

# Approval timeout (hours)
GATEKEEPER_APPROVAL_TIMEOUT=48
