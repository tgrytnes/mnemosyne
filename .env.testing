# Mnemosyne Testing Environment
# Use for CI/CD and integration tests

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=testing
LOG_LEVEL=INFO

# =============================================================================
# Ollama Configuration (CI environment)
# =============================================================================
# Note: In CI, Ollama may not be available - tests should mock it
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen3:0.6b

# =============================================================================
# Weaviate Configuration (GitHub Actions services)
# =============================================================================
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Collection Names (test-specific to avoid conflicts)
WEAVIATE_COLLECTION_MUSES=TheMuses_Test
WEAVIATE_COLLECTION_LETHE=TheLethe_Test
WEAVIATE_COLLECTION_DISCOVERY=DiscoveryDB_Test

# =============================================================================
# PostgreSQL Configuration (GitHub Actions services)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ananke_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test

# =============================================================================
# Test Data Paths (minimal data for CI)
# =============================================================================
VAULT_PATH=test_data/test_vault
EMAIL_ARCHIVE_PATH=test_data/test_emails
PDF_SCAN_PATH=test_data/test_pdfs
EMAIL_TSV=test_data/cleaned_emails_sample.tsv

# =============================================================================
# Ingestion Configuration (optimized for test speed)
# =============================================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=100
WATCHER_INTERVAL=5  # 5 seconds (fast for tests)
EMBEDDING_BATCH_SIZE=5  # Small batches for fast tests

# =============================================================================
# Scout Configuration (test settings)
# =============================================================================
SCOUT_CONFIDENCE_THRESHOLD=0.7
SCOUT_RUN_INTERVAL=1  # 1 hour (for integration tests)

# =============================================================================
# Gatekeeper Configuration
# =============================================================================
GATEKEEPER_AUTO_APPROVE_THRESHOLD=0.9
GATEKEEPER_APPROVAL_TIMEOUT=48

# =============================================================================
# Telegram Bot (mocked in tests)
# =============================================================================
TELEGRAM_BOT_TOKEN=test_token_not_real
TELEGRAM_USER_ID=12345678

# =============================================================================
# Linear Integration (optional in CI)
# =============================================================================
# LINEAR_API_KEY=not_needed_for_unit_tests
