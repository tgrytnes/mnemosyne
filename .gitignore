# Mnemosyne .gitignore

# Test data (not tracked)
test_data/

# Obsidian vaults (NEVER commit personal vaults)
**/obsidian_vault/
**/vault/
*.obsidian/

# Environment files (active .env not tracked, templates ARE tracked)
.env
.env.local
.env.*.local

# Secrets
secrets/
*.key
*_token
*_secret

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
htmlcov/
.coverage
*.backup

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
._*
