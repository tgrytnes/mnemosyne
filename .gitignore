# Mnemosyne .gitignore

# Test data (ignore everything except the committed fake vault)
test_data/*
!test_data/fake_vault/
!test_data/fake_vault/**

# Environment files (active .env not tracked, templates ARE tracked)
.env
.env.local
.env.*.local

# Secrets
secrets/
*.key
*_token
*_secret

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
htmlcov/
.coverage
*.backup
tests/pytest.log
*.log

# Generated story index
user-stories/stories.json

# Ingestion state (local development databases)
ingestion_state.db
*.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
._*
