# Mnemosyne .gitignore

# Test data (not tracked)
test_data/

# Environment files (active .env not tracked, templates ARE tracked)
.env
.env.local

# Secrets
secrets/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
htmlcov/
.coverage
*.backup

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
._*
